<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: run the session secret audit daily at 09:15, from the installed
  skill (~/.agents/skills/session-secret-audit) — no path to edit.

  Install:
    cp com.savoir-faire.secret-audit.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.savoir-faire.secret-audit.plist
    launchctl start com.savoir-faire.secret-audit     # run once now

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.savoir-faire.secret-audit.plist

  Log: ~/.claude/secret-audit/launchd.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.savoir-faire.secret-audit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>d="$HOME/.claude/secret-audit"; mkdir -p "$d"; exec "$HOME/.agents/skills/session-secret-audit/scripts/secret-audit.sh" &gt;&gt;"$d/launchd.log" 2&gt;&amp;1</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
